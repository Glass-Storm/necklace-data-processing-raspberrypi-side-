# ecosys-pi client environment — installed to /etc/ecosys/ecosys-client.env.
#
# systemd reads this file itself (EnvironmentFile=), so use plain KEY=value
# lines: no `export`, no shell expansion, no command substitution.
#
# Edit PI_ECOSYS_HUB to the phone hotspot gateway for the demo. The value below
# is the current demo hub; the phone is the access point and the Pi joins its
# hotspot, so the hub is normally the Pi's default gateway (check with
# `ip route` on the Pi).
PI_ECOSYS_HUB=10.240.85.29:9000

# Camera: the USB Y360 is a UVC device on /dev/video0. `uvc` hard-fails when
# the device (or ffmpeg) is missing; `auto` would prefer picamera2 instead.
PI_ECOSYS_VIDEO_SOURCE=uvc
PI_ECOSYS_VIDEO_DEVICE=/dev/video0

# Label sent in the unauthenticated stream_open frame.
PI_ECOSYS_DEVICE_NAME=ecosys-pi
